# Arcade-NMKMacPlus_MiSTer source list. Edit HERE, not in the .qsf: Quartus
# appends a copy of what this file sources to the end of the .qsf on every
# quartus_map run; revert that before committing (MS1Z lesson).
set_global_assignment -name SYSTEMVERILOG_FILE MacPlus.sv
set_global_assignment -name VERILOG_FILE rtl/pll.v
